all:
  vars:
    ansible_user: EDIT_USERNAME
    ansible_ssh_private_key_file: ~/.ssh/id_rsa
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no'
    python_ver: 3.12
    ansible_python_interpreter: '/home/{{ ansible_user }}/.venvs/ansible/python{{ python_ver }}/bin/python{{ python_ver }}'
# The node to execute `kubeadm init`. Should be exactly one node.
k8s_master:
  hosts:
    EDIT_HOSTNAME:
      ansible_host: EDIT_HOST_IP
# The nodes to execute `kubeadm join`. The number of those should be more than one.
k8s_worker:
  hosts:
    EDIT_HOSTNAME:
      ansible_host: EDIT_HOST_IP
